# =============================================================================
# VARIABLES DE ENTORNO PARA LABORATORIO MULTI-PARADIGMA DE BASES DE DATOS
# =============================================================================

# 1. PostgreSQL (Relacional)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=lab_sql

# 2. MongoDB (Documental)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=mongo
MONGO_PASSWORD=mongopassword
MONGO_DB=lab_nosql

# 3. Redis (Clave-Valor)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword

# 4. Neo4j (Grafos)
NEO4J_HOST=localhost
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# 5. InfluxDB (Series Temporales)
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086
INFLUXDB_ORG=devops-lab
INFLUXDB_BUCKET=telemetry-bucket
INFLUXDB_TOKEN=lab-super-secret-admin-token-2026
